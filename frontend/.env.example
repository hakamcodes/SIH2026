# Copy to `.env.local` (gitignored by Next.js's default .gitignore).
# Server-side only -- nothing here is prefixed NEXT_PUBLIC_, so none of it is
# ever bundled into client-side JavaScript. All API calls go through
# src/app/api/lmd/[...path]/route.ts, which reads these on the server.

# Where the FastAPI backend is running (see repo root: uvicorn lmd.main:app
# --reload --port 8000).
LMD_BACKEND_URL=http://localhost:8000

# Must exactly match LMD_INSPECTOR_API_TOKEN in the repo root .env -- the
# backend checks Authorization: Bearer <this value> on every inspector-only
# route (backend/lmd/api/deps.py require_inspector). If unset here, the
# Authorization header is simply not sent and the backend's own 500
# ("LMD_INSPECTOR_API_TOKEN is not configured") is what a write request sees.
LMD_INSPECTOR_API_TOKEN=

# Shown in the top bar only; purely cosmetic, safe to expose.
NEXT_PUBLIC_LMD_RULESET_VERSION=v1
