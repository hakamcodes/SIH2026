# Copy this file to `.env` (repo root) and fill in real values.
# `.env` is gitignored -- never commit it.

# Required for pipeline B (vision-model cross-check). Without this set, scans
# still run (pipeline A / RapidOCR only); numeric fields simply have no
# dual-pipeline confirmation signal.
ANTHROPIC_API_KEY=

# Optional: overrides the default vision model (claude-haiku-4-5-20251001).
LMD_VISION_MODEL=

# Required. All persistence (scans, cases, evidence, reports, audit log)
# lives in Firestore -- there is no local/offline database fallback anymore.
# Paste the FULL CONTENTS of a Firebase service account key JSON file as a
# single-line value here (Firebase console -> Project settings -> Service
# accounts -> Generate new private key). Do this the same way whether running
# locally via this .env file or as a Render environment variable -- a file
# path would not survive both targets identically, but this value does.
# The project ID is read out of this JSON, so nothing else is needed.
FIRESTORE_CREDENTIALS_JSON=

# Required for any inspector-authenticated API call (case updates, evidence
# upload, report generation, rules reload). Single shared token -- this is a
# hackathon-prototype auth model, not multi-user RBAC.
LMD_INSPECTOR_API_TOKEN=

# Signs BSA Section 63 certificates (HMAC-SHA256). If unset, a fixed
# development-only key is used and every certificate will say so.
LMD_EVIDENCE_SIGNING_KEY=

# Optional path override (default shown is relative to the repo root).
# LMD_RULES_PATH=packages/rules/lmd_rules.v1.json

# Comma-separated browser origins allowed to call the API (CORS). Defaults to
# the Next.js dev server if unset.
# LMD_CORS_ORIGINS=http://localhost:3000
