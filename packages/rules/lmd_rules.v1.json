    "on_fail_code": "NEEDS_REVIEW",
    "min_field_confidence": 1.0,
    "confidence_policy": "standard",
    "citation_verified": true,
    "_fixture_notes": "applicable_when field name corrected from ocr_pipeline.value/llm_pipeline.value to ocr_pipeline.numeric_val/llm_pipeline.numeric_val to match the condition's own field references and research/NotebookLM/rule_engine.py's actual field access -- the bare JSON version made LM-U02 permanently NOT_APPLICABLE."
