  {
    "rule_id": "LM-M01",
    "category": "MATH",
    "description": "Verify declared Unit Sale Price mathematically matches Net Quantity and MRP.",
    "legal_basis": "Legal Metrology (Packaged Commodities) Rules, 2011, Rule 6(11) (inserted 2021, effective 2022-04-01)",
    "effective_from": "2022-04-01",
    "effective_to": null,
    "applicable_when": "exists(usp_declared) AND commodity.category NOT IN ['combination_package', 'group_package', 'multi_piece_package']",
    "condition": "abs(usp_declared - (mrp.value / to_base_unit(net_quantity.value, net_quantity.unit))) <= max(0.01, 0.005 * usp_declared)",
    "severity": "BLOCKER",
    "on_fail_code": "MATH_MISMATCH",
    "min_field_confidence": 0.85,
    "confidence_policy": "standard",
    "citation_verified": true
  },
  {
    "rule_id": "LM-M02",
    "category": "MATH",
    "description": "Verify that net quantity declared across different panels and online listings matches.",
    "legal_basis": "Legal Metrology (Packaged Commodities) Rules, 2011, Rule 6(10)",
    "effective_from": "2018-01-01",
    "effective_to": null,
    "applicable_when": "exists(panel_a.net_quantity) AND exists(panel_b.net_quantity)",
    "condition": "abs(to_base_unit(panel_a.net_quantity.value, panel_a.net_quantity.unit) - to_base_unit(panel_b.net_quantity.value, panel_b.net_quantity.unit)) <= 0.01 * to_base_unit(panel_a.net_quantity.value, panel_a.net_quantity.unit)",
    "severity": "BLOCKER",
    "on_fail_code": "MATH_MISMATCH",
    "min_field_confidence": 0.85,
    "confidence_policy": "standard",
    "citation_verified": true
  },
  {
    "rule_id": "LM-M03",
    "category": "MATH",
    "description": "ADVISORY ONLY -- 50-paise MRP rounding is not a legal requirement in India; any MRP value is permitted. This check can never produce a non-compliant verdict; it is surfaced as an advisory observation only.",
    "legal_basis": "Legal Metrology (Packaged Commodities) Rules, 2011, MRP Rounding Provision",
    "effective_from": "2011-04-01",
    "effective_to": null,
    "applicable_when": "exists(mrp.computed_value)",
    "condition": "mrp.value == round_mrp_paise(mrp.computed_value)",
    "severity": "DIAGNOSTIC",
    "on_fail_code": "MATH_MISMATCH",
    "min_field_confidence": 0.8,
    "confidence_policy": "standard",
    "citation_verified": true
  },
  {
