  {
    "rule_id": "LM-T01",
    "category": "TEMPORAL",
    "description": "Verify that the compliance ruleset version was legally effective on the scan date.",
    "legal_basis": "Legal Metrology Act, 2009, Rule Engine Meta-Rule",
    "effective_from": "2011-04-01",
    "effective_to": null,
    "applicable_when": "true",
    "condition": "ruleset.effective_from <= system.scan_date AND (is_null(ruleset.effective_to) OR system.scan_date <= ruleset.effective_to)",
    "severity": "BLOCKER",
    "on_fail_code": "STALE_RULESET",
    "min_field_confidence": 1.0,
    "confidence_policy": "standard",
    "citation_verified": true,
    "exempt_from_effective_gate": true,
    "_fixture_notes": "Exempt from the generic per-rule effective-date gate: this rule's own job is to test whether scan_date falls inside the ruleset's valid window, so gating it by its own effective_from would make it silently NOT_IN_FORCE for exactly the pre-Act dates it exists to flag as violations."
  },
  {
