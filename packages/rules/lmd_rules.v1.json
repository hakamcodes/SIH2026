  {
    "rule_id": "LM-F07",
    "category": "FORMAT",
    "description": "Verify that consumer care phone number and email are well-formatted.",
    "legal_basis": "Legal Metrology (Packaged Commodities) Rules, 2011, Rule 6(2)",
